{
  "name": "bento-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure cross-platform desktop host for Bento",
  "productName": "Bento",
  "desktopName": "bento-desktop.desktop",
  "homepage": "https://github.com/invrnt/bento",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invrnt/bento.git"
  },
  "author": "Bento contributors",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22 <26"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "npm --prefix ../web run build && node scripts/copy-renderer.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "build": "npm run clean && npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/check-toolchain.mjs && npm run build:sidecar && npm run build && npm run build:config && electron-forge package",
    "make": "node scripts/check-toolchain.mjs && npm run build:sidecar && npm run build && npm run build:config && electron-forge make",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify:package": "node scripts/verify-artifacts.mjs --package-only",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "release:stage": "node scripts/stage-artifacts.mjs",
    "release:validate-tag": "node scripts/validate-release-tag.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "release:collect": "node scripts/collect-release-assets.mjs",
    "release:manifest": "node scripts/generate-update-manifest.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "checksums": "node scripts/checksums.mjs ../../dist/release",
    "build:config": "node scripts/write-build-config.mjs --keep-existing"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@types/node": "22.15.30",
    "electron": "43.4.1",
    "electron-winstaller": "5.4.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller@5.4.4": true
  }
}
