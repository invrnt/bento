<?xml version="1.0" encoding="utf-8"?>
<!-- Window themes (android.md §1): token colors only, edge-to-edge, no Material Components dependency.
     Compose content draws with BentoTheme; these only cover the window before and around it. -->
<resources>
    <style name="Base.Theme.Bento" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Bento" parent="Base.Theme.Bento">
        <item name="android:windowBackground">@color/bento_tray</item>
        <item name="android:colorAccent">@color/bento_accent</item>
        <item name="android:colorBackground">@color/bento_tray</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Bottom-sheet style activities (share target): the window is transparent and dimmed. -->
    <style name="Theme.Bento.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
