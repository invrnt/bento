#!/usr/bin/env python3
"""Bento local release tool (stdlib only, Python 3.11+). Runbook: docs/dev/releasing.md.

    scripts/release/bento-release                      dry-run build into dist/release/<version>/
    scripts/release/bento-release build --release      strict release build
    scripts/release/bento-release publish              push signed tags, create the GitHub releases
    scripts/release/bento-release --help               every command
"""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("bento-release needs Python 3.11 or later")
sys.path.insert(0, str(Path(__file__).resolve().parent))

from bento_release.cli import main  # noqa: E402

sys.exit(main())
