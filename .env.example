APP_NAME=Bento
APP_VERSION=0.1.0
ENVIRONMENT=local
HOST=127.0.0.1
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Extra host names (comma-separated) the headless API answers besides 127.0.0.1, localhost and [::1], e.g. when the UI
# reaches it as http://nas.local:8000. Read from the API process environment.
# BENTO_ALLOWED_HOSTS=
# Headless/Docker default: this machine only. The app default is `telegram` (Telegram-first, local until you sign in).
STORAGE_BACKEND=local
WORKER_CONCURRENCY=1
DATA_DIR=./data
OCR_PROVIDER=disabled
# Search by meaning: disabled | managed | custom | mock. `managed` is set by Ajustes › Búsqueda inteligente
# (it downloads the pinned model); setting it here locks the switch in the UI.
EMBEDDINGS_PROVIDER=disabled
# Managed model from the packaged manifest (default: the recommended one).
# BENTO_SMART_SEARCH_MODEL=embeddinggemma-2-q8_0
# Vector size; must be one of the model's Matryoshka sizes in `managed` mode (EmbeddingGemma 2: 768, 512, 256, 128).
# BENTO_EMBEDDING_DIMENSIONS=512
# `custom`: your own GGUF embedding model. JINA_MODEL_PATH and BENTO_EMBEDDING_MODEL_PATH still work as aliases.
# BENTO_CUSTOM_MODEL_PATH=./data/models/my-embedding-model.gguf
# BENTO_CUSTOM_MMPROJ_PATH=
# What the model expects before queries and documents: a plain prefix, or a template with {q} / {text}.
# BENTO_CUSTOM_QUERY_PREFIX=
# BENTO_CUSTOM_DOCUMENT_PREFIX=
# auto (from the GGUF) | mean | cls | last
# BENTO_CUSTOM_POOLING=auto
# llama.cpp `llama-server` to run instead of the bundled one.
# BENTO_LLAMA_SERVER_PATH=
# An external OpenAI-compatible embedding server; Bento then starts none. Anything but localhost receives your
# files' text unencrypted (warning `embedding_server_not_local`).
# BENTO_EMBEDDING_SERVER_URL=
# CPU threads for embedding (default: half the cores, at most 4).
# BENTO_EMBEDDING_THREADS=
# Bento's own Telegram application (build configuration for STORAGE_BACKEND=telegram; never user input).
BENTO_TELEGRAM_API_ID=
BENTO_TELEGRAM_API_HASH=
